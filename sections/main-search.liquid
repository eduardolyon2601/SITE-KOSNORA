<section class="section-light kosnora-py" style="background: #FFFFFF; color: #111111; padding: 4rem 1rem;">
  <div class="kosnora-container" style="max-width: 1000px; margin: 0 auto;">
    <div style="text-align: center; margin-bottom: 3rem;">
      <h1 class="kosnora-headline" style="font-size: 2.25rem; font-weight: 900; color: #111111; text-transform: uppercase;">
        Busca
      </h1>
      <form action="{{ routes.search_url }}" method="get" style="max-width: 500px; margin: 1.5rem auto 0; display: flex; gap: 8px;">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="Buscar capas ou modelos..."
          style="flex: 1; padding: 12px 16px; border-radius: 12px; border: 1px solid #D1D5DB; font-size: 14px; outline: none;"
        >
        <button
          type="submit"
          class="kosnora-btn-primary"
          style="padding: 12px 24px; border-radius: 12px; background: #9333EA; color: #FFF; font-weight: 800; border: none; cursor: pointer;"
        >
          Buscar
        </button>
      </form>
    </div>

    {% if search.performed %}
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem;">
        {% for item in search.results %}
          <div style="background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 1rem; padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <h3 style="font-size: 1rem; font-weight: 800; color: #111827; margin: 0 0 0.5rem 0;">
                <a href="{{ item.url }}" style="color: inherit; text-decoration: none;">{{ item.title }}</a>
              </h3>
              {% if item.price %}
                <div style="font-size: 1.1rem; font-weight: 900; color: #9333EA; margin-bottom: 0.75rem;">
                  {{ item.price | money }}
                </div>
              {% endif %}
            </div>
            <a href="{{ item.url }}" style="color: #9333EA; font-weight: 700; font-size: 13px; text-decoration: none;">
              Ver produto →
            </a>
          </div>
        {% else %}
          <div style="grid-column: 1 / -1; text-align: center; color: #6B7280; padding: 2rem 0;">
            Nenhum resultado encontrado para "{{ search.terms }}".
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Search Results",
  "settings": []
}
{% endschema %}
