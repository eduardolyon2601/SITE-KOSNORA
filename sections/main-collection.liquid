<section class="section-light kosnora-py" style="background: #FFFFFF; color: #111111; padding: 4rem 1rem;">
  <div class="kosnora-container" style="max-width: 1200px; margin: 0 auto;">
    <div style="text-align: center; margin-bottom: 3rem;">
      <h1 class="kosnora-headline" style="font-size: 2.5rem; font-weight: 900; color: #111111; text-transform: uppercase;">
        {{ collection.title | default: 'Coleções' }}
      </h1>
      {% if collection.description != blank %}
        <p style="color: #6B7280; font-size: 1rem; max-width: 600px; margin: 0.5rem auto 0;">
          {{ collection.description }}
        </p>
      {% endif %}
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 2rem;">
      {% for product in collection.products %}
        <div style="background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 1.25rem; overflow: hidden; padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
          <div style="aspect-ratio: 1; border-radius: 1rem; overflow: hidden; background: #F9FAFB; margin-bottom: 1rem; display: flex; align-items: center; justify-content: center;">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" style="width: 100%; height: 100%; object-fit: contain;">
            {% else %}
              <img src="{{ 'kosnora_hero_case.jpg' | asset_url }}" alt="KOSNORA" style="width: 100%; height: 100%; object-fit: contain;">
            {% endif %}
          </div>
          <div>
            <h3 style="font-size: 1.1rem; font-weight: 900; color: #111827; margin: 0 0 0.5rem 0; text-transform: uppercase;">
              {{ product.title }}
            </h3>
            <div style="font-size: 1.25rem; font-weight: 900; color: #9333EA; margin-bottom: 1rem;">
              {{ product.price | money }}
            </div>
            <a href="{{ product.url }}" class="kosnora-btn-primary" style="display: flex; align-items: center; justify-content: center; width: 100%; padding: 0.85rem; border-radius: 10px; text-decoration: none; font-weight: 800; font-size: 0.875rem; background: linear-gradient(135deg, #9333EA 0%, #8015F5 50%, #6B21A8 100%); color: #FFF;">
              VER DETALHES
            </a>
          </div>
        </div>
      {% else %}
        <div style="grid-column: 1 / -1; text-align: center; color: #6B7280; padding: 3rem 0;">
          Nenhum produto encontrado nesta coleção.
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "settings": []
}
{% endschema %}
