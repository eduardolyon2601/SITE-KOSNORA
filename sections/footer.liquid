<footer class="kosnora-footer" style="border-top: 1px solid #E5E7EB; padding: 4rem 0 2.5rem; color: #4B5563; background: #FFFFFF; width: 100%; max-width: 100%; min-width: 0; box-sizing: border-box;">
  <div class="kosnora-container" style="width: 100%; max-width: 1200px; margin-inline: auto; padding: 0 clamp(16px, 4vw, 32px); box-sizing: border-box; min-width: 0;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 2.5rem; padding-bottom: 3rem; border-bottom: 1px solid #E5E7EB; width: 100%; min-width: 0; box-sizing: border-box;">
      
      <!-- 1. Brand Column -->
      <div style="display: flex; flex-direction: column; gap: 0.875rem;">
        <a href="{{ routes.root_url | default: '/' }}" class="kosnora-logo" style="display: inline-flex; align-items: center; text-decoration: none;" aria-label="KOSNORA">
          <img src="{{ 'kosnora-brand-logo.png' | asset_url }}" alt="KOSNORA" style="height: 26px; width: auto; max-width: 120px; object-fit: contain;" />
        </a>
        <p style="font-size: 0.8125rem; font-weight: 800; color: #111827; text-transform: uppercase; letter-spacing: 0.05em; margin: 0;">
          Engineered for Everyday Protection
        </p>
        <p style="font-size: 0.8125rem; color: #6B7280; line-height: 1.6; margin: 0; max-width: 320px;">
          Smart precision cases engineered with premium finishes and advanced impact protection for your iPhone.
        </p>
        <!-- Security Badges in Brand Column -->
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem; font-size: 0.75rem; color: #059669; font-weight: 700;">
          <span>🔒 100% Secure Checkout</span>
          <span>·</span>
          <span>🚚 Fast US Shipping</span>
        </div>
      </div>

      <!-- 2. Quick Navigation -->
      <div>
        <div style="font-size: 0.6875rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.12em; color: #111827; margin-bottom: 1.25rem;">
          Navigation
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.8125rem; font-weight: 600;">
          <a href="#pricing" style="color: #4B5563; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#9333EA'" onmouseout="this.style.color='#4B5563'">Shop Cases</a>
          <a href="#benefits" style="color: #4B5563; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#9333EA'" onmouseout="this.style.color='#4B5563'">Why KOSNORA</a>
          <a href="#faq" style="color: #4B5563; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#9333EA'" onmouseout="this.style.color='#4B5563'">Frequently Asked Questions</a>
        </div>
      </div>

      <!-- 3. Official Policies & Legal Navigation -->
      <div>
        <div style="font-size: 0.6875rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.12em; color: #111827; margin-bottom: 1.25rem;">
          Policies & Terms
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.6875rem; font-size: 0.8125rem;">
          {% if shop.policies.size > 0 %}
            {% for policy in shop.policies %}
              {% if policy.url != blank %}
                <a href="{{ policy.url }}" class="kosnora-footer__link" style="color: #4B5563; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#9333EA'" onmouseout="this.style.color='#4B5563'">
                  {{ policy.title | escape }}
                </a>
              {% endif %}
            {% endfor %}
          {% else %}
            <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}" style="color: #4B5563; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#9333EA'" onmouseout="this.style.color='#4B5563'">
              Privacy Policy
            </a>
            <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}" style="color: #4B5563; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#9333EA'" onmouseout="this.style.color='#4B5563'">
              Shipping Policy
            </a>
            <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}" style="color: #4B5563; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#9333EA'" onmouseout="this.style.color='#4B5563'">
              Refund & Return Policy
            </a>
            <a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}" style="color: #4B5563; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#9333EA'" onmouseout="this.style.color='#4B5563'">
              Terms of Service
            </a>
            {% if shop.legal_notice %}
              <a href="{{ shop.legal_notice.url }}" style="color: #4B5563; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#9333EA'" onmouseout="this.style.color='#4B5563'">
                Legal Notice
              </a>
            {% endif %}
            <a href="{{ shop.contact_information.url | default: '/pages/contact' }}" style="color: #4B5563; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#9333EA'" onmouseout="this.style.color='#4B5563'">
              Contact Information
            </a>
          {% endif %}
        </div>
      </div>

      <!-- 4. Social & Atendimento (Instagram, TikTok, WhatsApp) -->
      <div>
        <div style="font-size: 0.6875rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.12em; color: #111827; margin-bottom: 1.25rem;">
          Customer Care
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.8125rem;">
          <a href="https://www.instagram.com/kosnora.us/" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 0.5rem; color: #4B5563; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#9333EA'" onmouseout="this.style.color='#4B5563'">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
            <span>Instagram: @kosnora.us</span>
          </a>
          <a href="https://www.tiktok.com/@kosnora" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 0.5rem; color: #4B5563; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#9333EA'" onmouseout="this.style.color='#4B5563'">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.29 0 .58.04.86.12V9.4a6.33 6.33 0 0 0-.86-.06 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.75a8.28 8.28 0 0 0 4.77 1.48V6.75a4.83 4.83 0 0 1-1-.06z"/></svg>
            <span>TikTok: @kosnora</span>
          </a>
          <a href="https://wa.me/19709962930" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 0.5rem; color: #059669; font-weight: 700; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#047857'" onmouseout="this.style.color='#059669'">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>WhatsApp: +1 (970) 996-2930</span>
          </a>
          <div style="font-size: 0.75rem; color: #9CA3AF; margin-top: 0.25rem;">
            Hours: Mon–Fri, 9:00 AM – 6:00 PM EST
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div style="padding-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; font-size: 0.75rem; color: #9CA3AF;">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'KOSNORA' }}. All rights reserved.
      </div>
      <div>
        iPhone is a registered trademark of Apple Inc. KOSNORA is an independent accessories brand.
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "KOSNORA"
    }
  ]
}
{% endschema %}
