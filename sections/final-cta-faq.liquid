<section id="faq" class="section-light" style="background: #FFFFFF; padding: 4.5rem 0 0; color: #111111;">
  <div class="kosnora-container" style="max-width: 800px;">
    <!-- 1. Compact FAQ Section (Section 5) -->
    <div style="margin-bottom: 4.5rem;">
      <div style="text-align: center; margin-bottom: 2.5rem;">
        <span style="font-size: 11px; font-weight: 900; letter-spacing: 0.15em; text-transform: uppercase; color: #9333EA; display: block; margin-bottom: 0.5rem;">
          QUESTIONS & ANSWERS
        </span>
        <h2 style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 900; text-transform: uppercase; margin: 0; color: #111111;">
          FREQUENTLY ASKED
        </h2>
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        <!-- Q1 -->
        <details class="faq-accordion-item" style="background: #FFFFFF; border: 1px solid #E5E5E5; border-radius: 12px; padding: 1rem 1.25rem; cursor: pointer;">
          <summary style="font-weight: 800; font-size: 0.95rem; list-style: none; display: flex; justify-content: space-between; align-items: center; color: #111111;">
            <span>How does the KOSNORA case work?</span>
            <span style="color: #9333EA; font-weight: 900;">+</span>
          </summary>
          <p style="margin-top: 0.75rem; font-size: 0.8125rem; color: #555555; font-weight: 500; line-height: 1.6; border-top: 1px solid #E5E5E5; padding-top: 0.75rem;">
            The KOSNORA case features a battery-free smart display on the back. It receives your selected picture from your phone via passive NFC in seconds. The image stays on display indefinitely without using power.
          </p>
        </details>

        <!-- Q2 -->
        <details class="faq-accordion-item" style="background: #FFFFFF; border: 1px solid #E5E5E5; border-radius: 12px; padding: 1rem 1.25rem; cursor: pointer;">
          <summary style="font-weight: 800; font-size: 0.95rem; list-style: none; display: flex; justify-content: space-between; align-items: center; color: #111111;">
            <span>Can I use my own picture?</span>
            <span style="color: #9333EA; font-weight: 900;">+</span>
          </summary>
          <p style="margin-top: 0.75rem; font-size: 0.8125rem; color: #555555; font-weight: 500; line-height: 1.6; border-top: 1px solid #E5E5E5; padding-top: 0.75rem;">
            Yes. You can use any photo from your phone gallery — portraits, couple shots, pets, wallpapers, or custom artwork.
          </p>
        </details>

        <!-- Q3 -->
        <details class="faq-accordion-item" style="background: #FFFFFF; border: 1px solid #E5E5E5; border-radius: 12px; padding: 1rem 1.25rem; cursor: pointer;">
          <summary style="font-weight: 800; font-size: 0.95rem; list-style: none; display: flex; justify-content: space-between; align-items: center; color: #111111;">
            <span>Does it need a battery?</span>
            <span style="color: #9333EA; font-weight: 900;">+</span>
          </summary>
          <p style="margin-top: 0.75rem; font-size: 0.8125rem; color: #555555; font-weight: 500; line-height: 1.6; border-top: 1px solid #E5E5E5; padding-top: 0.75rem;">
            No. The case is 100% battery-free. It requires no charging, cables, or internal battery. Your phone also does not drain power.
          </p>
        </details>

        <!-- Q4 -->
        <details class="faq-accordion-item" style="background: #FFFFFF; border: 1px solid #E5E5E5; border-radius: 12px; padding: 1rem 1.25rem; cursor: pointer;">
          <summary style="font-weight: 800; font-size: 0.95rem; list-style: none; display: flex; justify-content: space-between; align-items: center; color: #111111;">
            <span>Which iPhone models are supported?</span>
            <span style="color: #9333EA; font-weight: 900;">+</span>
          </summary>
          <p style="margin-top: 0.75rem; font-size: 0.8125rem; color: #555555; font-weight: 500; line-height: 1.6; border-top: 1px solid #E5E5E5; padding-top: 0.75rem;">
            KOSNORA supports iPhone 17, 16, 15, 14, and 12 series, including Pro and Pro Max models. Select your model before ordering.
          </p>
        </details>

        <!-- Q5 -->
        <details class="faq-accordion-item" style="background: #FFFFFF; border: 1px solid #E5E5E5; border-radius: 12px; padding: 1rem 1.25rem; cursor: pointer;">
          <summary style="font-weight: 800; font-size: 0.95rem; list-style: none; display: flex; justify-content: space-between; align-items: center; color: #111111;">
            <span>How do I customize it?</span>
            <span style="color: #9333EA; font-weight: 900;">+</span>
          </summary>
          <p style="margin-top: 0.75rem; font-size: 0.8125rem; color: #555555; font-weight: 500; line-height: 1.6; border-top: 1px solid #E5E5E5; padding-top: 0.75rem;">
            Choose your picture, align the frame on your phone, and hold it near the case. The image updates in under 5 minutes.
          </p>
        </details>

        <!-- Q6 -->
        <details class="faq-accordion-item" style="background: #FFFFFF; border: 1px solid #E5E5E5; border-radius: 12px; padding: 1rem 1.25rem; cursor: pointer;">
          <summary style="font-weight: 800; font-size: 0.95rem; list-style: none; display: flex; justify-content: space-between; align-items: center; color: #111111;">
            <span>How long does shipping take?</span>
            <span style="color: #9333EA; font-weight: 900;">+</span>
          </summary>
          <p style="margin-top: 0.75rem; font-size: 0.8125rem; color: #555555; font-weight: 500; line-height: 1.6; border-top: 1px solid #E5E5E5; padding-top: 0.75rem;">
            Orders are processed within 24–48 hours. Standard US delivery typically arrives in 3–7 business days with tracking included.
          </p>
        </details>
      </div>
    </div>

    <!-- 2. Final CTA Card (Section 6 - Immediately before Footer) -->
    <div style="background: #FFFFFF; border: 1px solid #E5E5E5; border-radius: 24px; padding: 3.5rem 2rem; text-align: center; margin-bottom: 4.5rem; position: relative; overflow: hidden; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);">
      <h2 style="font-size: clamp(2rem, 5vw, 3.25rem); font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em; margin-bottom: 0.75rem; color: #111111;">
        {{ section.settings.cta_headline | default: 'MAKE YOUR PHONE YOURS.' }}
      </h2>
      <p style="font-size: 1.15rem; color: #555555; font-weight: 600; margin-bottom: 2rem;">
        {{ section.settings.cta_subtitle | default: 'Change your look whenever you want.' }}
      </p>
      <button type="button" data-open-drawer data-qty="2" class="kosnora-btn-primary" style="background: linear-gradient(135deg, #9333EA 0%, #8015F5 50%, #6B21A8 100%); box-shadow: 0 4px 15px rgba(147, 51, 234, 0.35); padding: 1.15rem 2.75rem; font-size: 0.875rem; color: #FFF; border: none; cursor: pointer; border-radius: 12px; font-weight: 900; text-transform: uppercase; display: inline-flex; align-items: center; gap: 8px;">
        <span>{{ section.settings.cta_button | default: 'GET YOUR KOSNORA' }}</span>
        {% render 'icon-arrow-right' %}
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ + Final CTA",
  "settings": [
    {
      "type": "text",
      "id": "cta_headline",
      "label": "CTA Headline",
      "default": "MAKE YOUR PHONE YOURS."
    },
    {
      "type": "text",
      "id": "cta_subtitle",
      "label": "CTA Subtitle",
      "default": "Change your look whenever you want."
    },
    {
      "type": "text",
      "id": "cta_button",
      "label": "CTA Button",
      "default": "GET YOUR KOSNORA"
    }
  ],
  "presets": [
    {
      "name": "FAQ + Final CTA"
    }
  ]
}
{% endschema %}
