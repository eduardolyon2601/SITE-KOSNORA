<section class="section-light kosnora-py" style="background: #FFFFFF; color: #111111; padding: 4rem 1rem;">
  <div class="kosnora-container" style="max-width: 800px; margin: 0 auto;">
    <h1 class="kosnora-headline" style="font-size: 2.25rem; font-weight: 900; color: #111111; margin-bottom: 2rem; text-transform: uppercase;">
      {{ page.title }}
    </h1>
    <div class="rte" style="color: #4B5563; line-height: 1.8; font-size: 1rem;">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
