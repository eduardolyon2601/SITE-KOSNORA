<section class="section-light kosnora-py" style="background: #FFFFFF; color: #111111;">
  <div class="kosnora-container" style="max-width: 600px; text-align: center;">
    <h1 class="kosnora-headline" style="font-size: 2.25rem; color: #111111; margin-bottom: 1.5rem;">
      Your Cart
    </h1>
    {% if cart.item_count > 0 %}
      <div style="background: #FFFFFF; border: 1px solid #E5E5E5; border-radius: 1.25rem; padding: 2rem; margin-bottom: 2rem;">
        {% for item in cart.items %}
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 1rem 0; border-bottom: 1px solid #E5E5E5;">
            <div style="text-align: left;">
              <div style="font-weight: 700; color: #111111;">{{ item.title }}</div>
              <div style="font-size: 12px; color: #555555;">Qty: {{ item.quantity }}</div>
            </div>
            <div style="font-weight: 800; color: #111111;">{{ item.final_line_price | money }}</div>
          </div>
        {% endfor %}
        <div style="display: flex; justify-content: space-between; font-size: 1.25rem; font-weight: 800; color: #111111; margin-top: 1.5rem;">
          <span>Total:</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
      </div>
      <a href="/checkout" class="kosnora-btn-primary" style="width: 100%; justify-content: center;">
        <span>CHECKOUT</span>
        {% render 'icon-arrow-right' %}
      </a>
    {% else %}
      <p style="color: #555555; margin-bottom: 2rem;">Your cart is currently empty.</p>
      <button type="button" data-open-drawer data-qty="2" class="kosnora-btn-primary">
        <span>GET YOUR KOSNORA CASE</span>
        {% render 'icon-arrow-right' %}
      </button>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
