<script>
  (function() {
    function initReviewsSection(section) {
      const track = section.querySelector('.kosnora-reviews-track');
      const prevBtn = section.querySelector('[id^="reviews-prev-btn"]');
      const nextBtn = section.querySelector('[id^="reviews-next-btn"]');
      if (!track) return;

      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          track.scrollBy({ left: -280, behavior: 'smooth' });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          track.scrollBy({ left: 280, behavior: 'smooth' });
        });
      }

      // Smooth auto-scroll loop with pause on hover / touch
      let isPaused = false;
      section.addEventListener('mouseenter', () => { isPaused = true; });
      section.addEventListener('mouseleave', () => { isPaused = false; });
      section.addEventListener('touchstart', () => { isPaused = true; }, { passive: true });
      section.addEventListener('touchend', () => { isPaused = false; }, { passive: true });

      let autoScrollTimer = setInterval(() => {
        if (!isPaused && track) {
          if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 10) {
            track.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            track.scrollBy({ left: 1, behavior: 'auto' });
          }
        }
      }, 30);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.kosnora-reviews-section').forEach(initReviewsSection);
      });
    } else {
      document.querySelectorAll('.kosnora-reviews-section').forEach(initReviewsSection);
    }

    document.addEventListener('shopify:section:load', (e) => {
      const s = e.target.querySelector('.kosnora-reviews-section');
      if (s) initReviewsSection(s);
    });
  })();
</script>

