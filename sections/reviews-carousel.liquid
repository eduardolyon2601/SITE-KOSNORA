              &ldquo;Ordered the bundle so my partner and I could match our photos. Switching covers and updating pictures for special moments and date nights is so fun. Build quality is exceptional!&rdquo;
            </p>
          </div>

          <div style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid #F3F4F6; display: flex; justify-content: space-between; font-size: 11px; font-weight: 700; color: #9CA3AF;">
            <span>NFC Smart Screen</span>
            <span style="color: #9333EA;">KOSNORA Original</span>
          </div>
        </article>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (function() {
    function initReviewsSection(section) {
      const track = section.querySelector('.kosnora-reviews-track');
      const prevBtn = section.querySelector('[id^="reviews-prev-btn"]');
      const nextBtn = section.querySelector('[id^="reviews-next-btn"]');
      if (!track) return;

      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          track.scrollBy({ left: -350, behavior: 'smooth' });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          track.scrollBy({ left: 350, behavior: 'smooth' });
        });
      }

      // Smooth auto-scroll loop
      let isPaused = false;
      section.addEventListener('mouseenter', () => { isPaused = true; });
      section.addEventListener('mouseleave', () => { isPaused = false; });
      section.addEventListener('touchstart', () => { isPaused = true; }, { passive: true });
      section.addEventListener('touchend', () => { isPaused = false; }, { passive: true });

      let autoScrollTimer = setInterval(() => {
        if (!isPaused && track) {
          if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 10) {
            track.scrollTo({ left: 0, behavior: 'smooth' });
          } else {
            track.scrollBy({ left: 1, behavior: 'auto' });
          }
        }
      }, 30);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.kosnora-reviews-section').forEach(initReviewsSection);
      });
    } else {
      document.querySelectorAll('.kosnora-reviews-section').forEach(initReviewsSection);
    }

    document.addEventListener('shopify:section:load', (e) => {
      const s = e.target.querySelector('.kosnora-reviews-section');
      if (s) initReviewsSection(s);
    });
  })();
</script>

