              <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=64&auto=format&fit=crop&q=80" alt="Customer" style="width: 20px; height: 20px; border-radius: 9999px; border: 2px solid #FFF; object-fit: cover;" />
            </div>

            <!-- 4.7 Score & Stars -->
