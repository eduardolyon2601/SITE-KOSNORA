              <span style="font-size: 12px; font-weight: 900; color: #111827; line-height: 1;">4.7</span>
              <div style="display: flex; align-items: center; gap: 1px; color: #9333EA;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="#9333EA" stroke="#9333EA" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="#9333EA" stroke="#9333EA" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="#9333EA" stroke="#9333EA" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="#9333EA" stroke="#9333EA" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
