                </div>
                <span style="font-size: 10px; font-weight: 800; text-transform: uppercase; color: #374151; letter-spacing: 0.04em;">Black</span>
              </button>
              <button type="button" data-gallery-desktop data-src="https://i.postimg.cc/pVFFjkrr/Whats-App-Image-2026-10-09-at-02-44-27.jpg" data-name="Pink" style="padding: 4px 10px; border-radius: 9999px; border: 1.5px solid #E5E7EB; background: #FFF; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all 0.15s ease;">
                <div style="width: 14px; height: 18px; border-radius: 3px; overflow: hidden; background: #F3F4F6; flex-shrink: 0;">
                  <img src="https://i.postimg.cc/pVFFjkrr/Whats-App-Image-2026-10-09-at-02-44-27.jpg" alt="Pink" style="width: 100%; height: 100%; object-fit: contain;">
                </div>
                <span style="font-size: 10px; font-weight: 800; text-transform: uppercase; color: #374151; letter-spacing: 0.04em;">Pink</span>
              </button>
              <button type="button" data-gallery-desktop data-src="https://i.postimg.cc/kGKRdML9/Whats-App-Image-2026-10-09-at-02-47-31.jpg" data-name="White" style="padding: 4px 10px; border-radius: 9999px; border: 1.5px solid #E5E7EB; background: #FFF; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all 0.15s ease;">
                <div style="width: 14px; height: 18px; border-radius: 3px; overflow: hidden; background: #F3F4F6; flex-shrink: 0;">
                  <img src="https://i.postimg.cc/kGKRdML9/Whats-App-Image-2026-10-09-at-02-47-31.jpg" alt="White" style="width: 100%; height: 100%; object-fit: contain;">
