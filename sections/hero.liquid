{%- assign hero_product = section.settings.product | default: target_product | default: product -%}
{%- if hero_product != blank and hero_product.id != blank -%}
  <script type="application/json" id="kosnora-hero-product-data">
    {{ hero_product | json }}
  </script>
{%- endif -%}

<section id="pricing" class="section-light kosnora-py kosnora-pricing-section" style="position: relative; overflow: visible; background: #FFFFFF; color: #111827; border-bottom: 1px solid #E5E7EB; padding-top: 2rem; padding-bottom: 3.5rem;">
  <div class="kosnora-container" style="max-width: 1200px; margin: 0 auto; padding: 0 1rem; position: relative; z-index: 2;">
    
    <!-- DESKTOP VIEW (Side-by-side: Product & Photos on Left, Values on Right) -->
    <div class="kosnora-desktop-hero" style="display: none;">
      <div style="display: grid; grid-template-columns: 5fr 7fr; gap: 3rem; align-items: start;">
        
        <!-- Left: Product Photos & Video Showcase Gallery -->
        <div style="display: flex; flex-direction: column; align-items: center;">
