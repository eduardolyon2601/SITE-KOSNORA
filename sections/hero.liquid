                </div>
                <span style="font-size: 10px; font-weight: 800; text-transform: uppercase; color: #374151; letter-spacing: 0.04em;">Gray</span>
              </button>
              <button type="button" data-gallery-desktop data-src="https://i.postimg.cc/CMqq8J51/Whats-App-Image-2026-10-07-at-00-11-55.jpg" data-name="Black" style="padding: 4px 10px; border-radius: 9999px; border: 1.5px solid #E5E7EB; background: #FFF; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all 0.15s ease;">
                <div style="width: 14px; height: 18px; border-radius: 3px; overflow: hidden; background: #F3F4F6; flex-shrink: 0;">
