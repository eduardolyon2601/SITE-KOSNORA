          <!-- Title for purchasing options -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span style="font-size: 12px; font-weight: 900; text-transform: uppercase; color: #111827; letter-spacing: 0.05em;">Bundles & Pricing:</span>
            <span style="font-size: 11px; font-weight: 600; color: #6B7280;">Click any option below to select</span>
          </div>

          <!-- 3 Values Options Grid (Desktop: 1 for $79.90, 2 for 139.90, and 3 for 194.90 - Zero Border Clipping) -->
          <div class="kosnora-tier-grid-desktop">
            <!-- 1 for $79.90 -->
            <div data-tier-select="1" data-open-drawer data-qty="1" class="kosnora-tier-card">
              <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
