              <div id="desktop-color-badge" style="display: none; position: absolute; bottom: 0.75rem; left: 0.75rem; padding: 0.35rem 0.75rem; border-radius: 0.75rem; background: rgba(0,0,0,0.75); backdrop-filter: blur(8px); color: #FFF; font-size: 11px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.05em; z-index: 3;">
                Gray
              </div>
            </div>
          </div>

          <div style="width: 100%; margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid #E5E7EB; display: flex; justify-content: space-around; font-size: 11px; font-weight: 600; color: #6B7280;">
            <span>🛡️ 30-Day Guarantee</span>
            <span>•</span>
            <span>🚚 Tracked Shipping</span>
          </div>
        </div>

        <!-- Right: Headline, Color Options (Above Pricing), CTA, and 3 Values Options -->
