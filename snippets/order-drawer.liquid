{%- assign target_product = nil -%}
{%- if product != nil and product.id != blank -%}
  {%- assign target_product = product -%}
{%- elsif settings.featured_product != blank and all_products[settings.featured_product] != blank -%}
  {%- assign target_product = all_products[settings.featured_product] -%}
{%- elsif collections.all.products.size > 0 -%}
  {%- assign target_product = collections.all.products.first -%}
{%- elsif collections.frontpage.products.size > 0 -%}
  {%- assign target_product = collections.frontpage.products.first -%}
{%- else -%}
  {%- for col in collections -%}
    {%- if col.products.size > 0 and target_product == nil -%}
      {%- assign target_product = col.products.first -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if target_product == nil or target_product.id == blank -%}
  {%- assign target_product = all_products['kosnora-case'] | default: all_products['kosnora'] | default: all_products['kosnora-ink-nfc-smart-phone-case'] | default: all_products['kosnora-smart-phone-case'] -%}
{%- endif -%}

{%- assign real_variant = target_product.selected_or_first_available_variant | default: target_product.variants.first -%}
{%- assign initial_image = real_variant.featured_image | default: target_product.featured_image | default: 'https://i.postimg.cc/m24tHsKv/Whats-App-Image-2026-10-09-at-02-56-11.jpg' -%}

{%- if target_product != nil -%}
  <script type="application/json" id="kosnora-product-data">
    {{ target_product | json }}
  </script>
{%- endif -%}

<div id="kosnora-order-drawer" class="kosnora-drawer-backdrop" aria-hidden="true">
  <div class="kosnora-drawer" role="dialog" aria-modal="true" aria-label="Seu Carrinho KOSNORA" style="background: #FFFFFF; color: #111111; display: flex; flex-direction: column; justify-content: space-between; height: 100%;">
    
    <!-- Header -->
    <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid #E5E7EB; display: flex; align-items: center; justify-content: space-between; background: #FFFFFF; position: sticky; top: 0; z-index: 10;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <div style="width: 32px; height: 32px; border-radius: 8px; background: #FAF5FF; color: #9333EA; display: flex; align-items: center; justify-content: center;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </div>
        <div>
          <h2 style="font-size: 0.95rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.05em; color: #111827; margin: 0;">
            Seu Carrinho
          </h2>
          <p id="drawer-item-count-label" style="font-size: 11px; font-weight: 600; color: #6B7280; margin: 1px 0 0 0;">
            1 item selecionado
          </p>
        </div>
      </div>
      <button type="button" data-close-drawer style="background: none; border: none; color: #6B7280; cursor: pointer; padding: 6px; border-radius: 8px; display: flex; align-items: center; justify-content: center;" aria-label="Fechar carrinho">
        {% render 'icon-close' %}
      </button>
    </div>

    <!-- Minimalist Cart Body: Clean, Conversion-Optimized (Zero duplicate selectors!) -->
    <div id="drawer-config-area" style="padding: 1.5rem; flex: 1; display: flex; flex-direction: column; gap: 1.25rem; background: #FFFFFF; overflow-y: auto;">
      
      <!-- Essential Product Card -->
      <div style="padding: 1rem; border-radius: 1rem; border: 1px solid #E5E7EB; background: #F9FAFB; display: flex; gap: 1rem; align-items: flex-start;">
        <!-- Product Thumbnail (Dynamic matching variant/color) -->
        <div style="width: 80px; height: 96px; border-radius: 0.75rem; overflow: hidden; background: #FFFFFF; border: 1px solid #E5E7EB; flex-shrink: 0; padding: 4px; display: flex; align-items: center; justify-content: center;">
          <img
            id="drawer-product-img"
            src="{{ initial_image }}"
            alt="{{ target_product.title | default: 'KOSNORA Case' }}"
            style="width: 100%; height: 100%; object-fit: contain;"
          >
        </div>

        <!-- Product Details -->
        <div style="flex: 1; min-width: 0;">
          <h3 id="drawer-product-title" style="font-size: 0.9rem; font-weight: 900; text-transform: uppercase; color: #111827; margin: 0; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
            {{ target_product.title | default: 'KOSNORA Case' }}
          </h3>

          <!-- Preserved Variant Selection (Read-only badge - NEVER forces re-selecting!) -->
          <div id="drawer-options-pill" style="display: inline-flex; align-items: center; gap: 6px; margin-top: 5px; padding: 3px 8px; border-radius: 6px; background: #FFFFFF; border: 1px solid #E5E7EB; font-size: 11px; font-weight: 700; color: #374151;">
            <span style="width: 7px; height: 7px; border-radius: 50%; background: #9333EA;"></span>
            <span id="drawer-summary-color">Gray</span>
            <span style="color: #D1D5DB;">•</span>
            <span id="drawer-summary-model">iPhone 16 Pro Max</span>
          </div>

          <!-- Unit price row -->
          <div id="drawer-unit-price-display" style="margin-top: 6px; font-size: 12px; font-weight: 700; color: #4B5563;">
            <span id="drawer-unit-price-val">R$ 79,90</span>
            <span id="drawer-unit-price-suffix" style="display: none; font-size: 10px; color: #9CA3AF; font-weight: 600;">/ cada</span>
          </div>

          <!-- Quantity Stepper [ - ] qty [ + ] -->
          <div style="margin-top: 10px; display: flex; align-items: center; gap: 8px;">
            <div style="display: inline-flex; align-items: center; border-radius: 10px; background: #FFFFFF; border: 1px solid #D1D5DB; padding: 2px;">
              <button
                type="button"
                id="drawer-qty-minus"
                style="width: 30px; height: 30px; border-radius: 8px; border: none; background: transparent; color: #374151; font-size: 14px; font-weight: 800; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.15s ease;"
                aria-label="Diminuir quantidade"
              >
                −
              </button>
              
              <span id="drawer-qty-display" style="width: 36px; text-align: center; font-size: 13px; font-weight: 900; color: #111827;">
                1
              </span>

              <button
                type="button"
                id="drawer-qty-plus"
                style="width: 30px; height: 30px; border-radius: 8px; border: none; background: transparent; color: #374151; font-size: 14px; font-weight: 800; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.15s ease;"
                aria-label="Aumentar quantidade"
              >
                +
              </button>
            </div>

            <!-- Volume Tag badge -->
            <span id="drawer-bundle-tag" style="display: none; font-size: 10px; font-weight: 900; text-transform: uppercase; color: #9333EA; background: #FAF5FF; padding: 3px 8px; border-radius: 9999px; border: 1px solid #E9D5FF;">
              2x Pack
            </span>
          </div>
        </div>
      </div>

      <!-- Financial Breakdown / Automatic Pricing Recalculation -->
      <div style="background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 1rem; padding: 1.25rem; display: flex; flex-direction: column; gap: 0.65rem;">
        <div style="font-size: 11px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.05em; color: #6B7280; margin-bottom: 2px;">
          Resumo do Pedido
        </div>

        <!-- Subtotal -->
        <div style="display: flex; justify-content: space-between; font-size: 12px; font-weight: 600; color: #4B5563;">
          <span id="drawer-subtotal-label">Subtotal (1 unidade):</span>
          <span id="drawer-subtotal-val" style="color: #111827; font-weight: 700;">R$ 79,90</span>
        </div>

        <!-- Promotional Discount Line (Dynamic and Instant) -->
        <div id="drawer-discount-row" style="display: none; justify-content: space-between; align-items: center; font-size: 12px; font-weight: 900; color: #059669; background: #ECFDF5; padding: 6px 10px; border-radius: 8px; border: 1px solid #A7F3D0;">
          <span style="display: flex; align-items: center; gap: 5px;">
            <span style="width: 6px; height: 6px; border-radius: 50%; background: #10B981;"></span>
            <span id="drawer-discount-title">Desconto Promocional:</span>
          </span>
          <span id="drawer-discount-val">-R$ 19,90</span>
        </div>

        <!-- Shipping Row -->
        <div style="display: flex; justify-content: space-between; font-size: 12px; font-weight: 600; color: #4B5563;">
          <span>Envio:</span>
          <span style="color: #059669; font-weight: 800;">Grátis</span>
        </div>

        <!-- Total Row -->
        <div style="border-top: 1px solid #E5E7EB; padding-top: 10px; margin-top: 4px; display: flex; justify-content: space-between; align-items: baseline;">
          <div>
            <span style="font-size: 14px; font-weight: 900; color: #111827; text-transform: uppercase;">Total:</span>
            <span id="drawer-savings-note" style="display: none; font-size: 10px; font-weight: 700; color: #059669; margin-top: 1px;">
              Você economiza R$ 19,90
            </span>
          </div>
          <div style="text-align: right;">
            <span id="drawer-total-price" style="font-size: 1.25rem; font-weight: 900; color: #111827;">
              R$ 79,90
            </span>
          </div>
        </div>
      </div>

      <!-- Trust Badges -->
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 10px; font-weight: 700; color: #4B5563; text-align: center;">
        <div style="padding: 8px; border-radius: 10px; background: #F9FAFB; border: 1px solid #E5E7EB; display: flex; align-items: center; justify-content: center; gap: 5px;">
          <span>🚚</span>
          <span>Envio Rastreado</span>
        </div>
        <div style="padding: 8px; border-radius: 10px; background: #F9FAFB; border: 1px solid #E5E7EB; display: flex; align-items: center; justify-content: center; gap: 5px;">
          <span>🛡️</span>
          <span>Garantia de 30 Dias</span>
        </div>
      </div>

    </div>

    <!-- Hidden Shopify Cart Add Form preserving the real variant and dynamic quantity -->
    <form action="{{ routes.cart_add_url | default: '/cart/add' }}" method="post" id="kosnora-drawer-cart-form" enctype="multipart/form-data" style="display: none;">
      <input type="hidden" name="id" id="drawer-variant-id" value="{{ real_variant.id }}">
      <input type="hidden" name="quantity" id="drawer-quantity-input" value="1">
      <input type="hidden" name="return_to" value="/checkout">
      <input type="hidden" name="properties[iPhone Model]" id="drawer-prop-model" value="iPhone 16 Pro Max">
      <input type="hidden" name="properties[Case Color]" id="drawer-prop-color" value="Gray">
      <input type="hidden" name="properties[Offer Selection]" id="drawer-prop-offer" value="1 Case">
    </form>

    <!-- Drawer Footer: Official Shopify Checkout CTA -->
    <div style="padding: 1.25rem 1.5rem; border-top: 1px solid #E5E7EB; background: #FFFFFF; position: sticky; bottom: 0;">
      <!-- Variant Alert / Availability Message -->
      <div id="drawer-variant-alert" style="display: none; padding: 0.65rem 0.85rem; border-radius: 0.75rem; font-size: 12px; font-weight: 700; text-align: center; margin-bottom: 0.75rem; line-height: 1.4;"></div>

      <button type="button" id="drawer-proceed-checkout" class="kosnora-btn-primary" style="width: 100%; justify-content: center; cursor: pointer; padding: 1rem 1.5rem; font-size: 0.875rem; font-weight: 900; letter-spacing: 0.05em; border-radius: 12px; background: linear-gradient(135deg, #9333EA 0%, #8015F5 50%, #6B21A8 100%); color: #FFF; border: none; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 14px rgba(147, 51, 234, 0.35);">
        <span>CONTINUAR PARA O CHECKOUT (<span id="drawer-cta-total">R$ 79,90</span>)</span>
        {% render 'icon-arrow-right' %}
      </button>

      <div style="font-size: 10px; color: #9CA3AF; text-align: center; margin-top: 8px; font-weight: 500;">
        Ambiente seguro Shopify · Seus dados e variantes estão preservados
      </div>
    </div>

  </div>
</div>
