{%- assign target_product = nil -%}
{%- if product != nil and product.id != blank -%}
  {%- assign target_product = product -%}
{%- elsif settings.featured_product != blank and all_products[settings.featured_product] != blank -%}
  {%- assign target_product = all_products[settings.featured_product] -%}
{%- elsif collections.all.products.size > 0 -%}
  {%- assign target_product = collections.all.products.first -%}
{%- elsif collections.frontpage.products.size > 0 -%}
  {%- assign target_product = collections.frontpage.products.first -%}
{%- else -%}
  {%- for col in collections -%}
    {%- if col.products.size > 0 and target_product == nil -%}
      {%- assign target_product = col.products.first -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if target_product == nil or target_product.id == blank -%}
  {%- assign target_product = all_products['kosnora-case'] | default: all_products['kosnora'] | default: all_products['kosnora-ink-nfc-smart-phone-case'] | default: all_products['kosnora-smart-phone-case'] -%}
{%- endif -%}

{%- assign real_variant = target_product.selected_or_first_available_variant | default: target_product.variants.first -%}

{%- if target_product != nil -%}
  <script type="application/json" id="kosnora-product-data">
    {{ target_product | json }}
  </script>
{%- endif -%}

<div id="kosnora-order-drawer" class="kosnora-drawer-backdrop" aria-hidden="true">
  <div class="kosnora-drawer" role="dialog" aria-modal="true" aria-label="Order Configuration" style="background: #FFFFFF; color: #111111;">
    <!-- Header -->
    <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid #E5E5E5; display: flex; align-items: center; justify-content: space-between; background: #FFFFFF;">
      <div>
        <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #9333EA;">
          Order Configuration
        </div>
        <h3 style="font-size: 1.125rem; font-weight: 800; color: #111111; margin-top: 2px;">
          KOSNORA Case
        </h3>
      </div>
      <button type="button" data-close-drawer style="background: none; border: none; color: #555555; cursor: pointer; padding: 6px; border-radius: 8px;">
        {% render 'icon-close' %}
      </button>
    </div>

    <!-- Configuration Body -->
    <div id="drawer-config-area" style="padding: 1.5rem; flex: 1; display: flex; flex-direction: column; gap: 1.5rem; background: #FFFFFF; overflow-y: auto;">
      <!-- 1. Bundle selection -->
      <div>
        <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #555555; margin-bottom: 0.75rem;">
          1. Select Quantity Bundle:
        </label>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          <!-- 1 Case -->
          <div data-bundle-quantity="1" class="kosnora-bundle-card active-bundle" style="padding: 1rem; border-radius: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: space-between; border: 2px solid #9333EA; background: #FAF5FF;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <div class="bundle-radio-circle" style="width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: #9333EA;">
                <span class="bundle-radio-dot" style="width: 8px; height: 8px; border-radius: 50%; background: #FFF;"></span>
              </div>
              <div>
                <div style="font-size: 0.875rem; font-weight: 800; color: #111111;">1 CASE</div>
                <div style="font-size: 0.75rem; color: #777777; font-weight: 500;">$79.90 single case</div>
              </div>
            </div>
            <div style="font-size: 1rem; font-weight: 800; color: #111111;">$79.90</div>
          </div>

          <!-- 2 Cases -->
          <div data-bundle-quantity="2" class="kosnora-bundle-card" style="padding: 1rem; border-radius: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: space-between; border: 1px solid #E5E5E5; background: #FFF;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <div class="bundle-radio-circle" style="width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid #D1D5DB;">
                <span class="bundle-radio-dot" style="width: 8px; height: 8px; border-radius: 50%;"></span>
              </div>
              <div>
                <div style="display: flex; align-items: center; gap: 6px;">
                  <span style="font-size: 0.875rem; font-weight: 800; color: #111111;">2 CASES</span>
                  <span style="font-size: 10px; font-weight: 800; padding: 2px 6px; border-radius: 4px; background: #9333EA; color: #FFFFFF;">POPULAR</span>
                </div>
                <div style="font-size: 0.75rem; color: #777777; font-weight: 500;">$69.95 each · $139.90 total</div>
              </div>
            </div>
            <div style="text-align: right;">
              <div style="font-size: 1rem; font-weight: 800; color: #111111;">$139.90</div>
              <div style="font-size: 11px; color: #059669; font-weight: 700;">Save $19.90</div>
            </div>
          </div>

          <!-- 3 Cases -->
          <div data-bundle-quantity="3" class="kosnora-bundle-card" style="padding: 1rem; border-radius: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: space-between; border: 1px solid #E5E5E5; background: #FFF;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <div class="bundle-radio-circle" style="width: 18px; height: 18px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid #D1D5DB;">
                <span class="bundle-radio-dot" style="width: 8px; height: 8px; border-radius: 50%;"></span>
              </div>
              <div>
                <div style="display: flex; align-items: center; gap: 6px;">
                  <span style="font-size: 0.875rem; font-weight: 800; color: #111111;">3 CASES</span>
                  <span style="font-size: 10px; font-weight: 800; padding: 2px 6px; border-radius: 4px; background: #059669; color: #FFFFFF;">BEST VALUE</span>
                </div>
                <div style="font-size: 0.75rem; color: #777777; font-weight: 500;">$64.97 each · $194.90 total</div>
              </div>
            </div>
            <div style="text-align: right;">
              <div style="font-size: 1rem; font-weight: 800; color: #111111;">$194.90</div>
              <div style="font-size: 11px; color: #059669; font-weight: 700;">Save $44.80</div>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Model selection -->
      <div>
        <label for="drawer-model-select" style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #555555; margin-bottom: 0.5rem;">
          2. Compatible iPhone Model:
        </label>
        <select id="drawer-model-select" style="width: 100%; padding: 0.85rem 1rem; border-radius: 0.75rem; background: #FFFFFF; border: 1px solid #E5E5E5; color: #111111; font-size: 0.875rem; font-weight: 600;">
          <option value="iPhone 17 Pro Max">iPhone 17 Pro Max</option>
          <option value="iPhone 17 Pro">iPhone 17 Pro</option>
          <option value="iPhone 17">iPhone 17</option>
          <option value="iPhone 16 Pro Max">iPhone 16 Pro Max</option>
          <option value="iPhone 16 Pro">iPhone 16 Pro</option>
          <option value="iPhone 16 Plus">iPhone 16 Plus</option>
          <option value="iPhone 16">iPhone 16</option>
          <option value="iPhone 15 Pro Max">iPhone 15 Pro Max</option>
          <option value="iPhone 15 Pro">iPhone 15 Pro</option>
          <option value="iPhone 15 Plus">iPhone 15 Plus</option>
          <option value="iPhone 15">iPhone 15</option>
          <option value="iPhone 14 Pro Max">iPhone 14 Pro Max</option>
          <option value="iPhone 14 Pro">iPhone 14 Pro</option>
          <option value="iPhone 14 Plus">iPhone 14 Plus</option>
          <option value="iPhone 14">iPhone 14</option>
          <option value="iPhone 12 Pro Max">iPhone 12 Pro Max</option>
          <option value="iPhone 12 Pro">iPhone 12 Pro</option>
          <option value="iPhone 12">iPhone 12</option>
        </select>
      </div>

      <!-- 3. Color selection (Gray, Black, Pink, White, Orange) -->
      <div>
        <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #555555; margin-bottom: 0.5rem;">
          3. Case Color:
        </label>
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem;">
          <button type="button" data-drawer-color data-name="Gray" class="active-color" style="padding: 0.65rem 0.5rem; border-radius: 0.75rem; border: 2px solid #9333EA; background: #FAF5FF; color: #111111; font-size: 0.75rem; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer;">
            <span style="width: 12px; height: 12px; border-radius: 50%; background: #6B7280; border: 1px solid #D1D5DB;"></span>
            <span>Gray</span>
          </button>
          <button type="button" data-drawer-color data-name="Black" style="padding: 0.65rem 0.5rem; border-radius: 0.75rem; border: 1px solid #E5E5E5; background: #FFFFFF; color: #111111; font-size: 0.75rem; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer;">
            <span style="width: 12px; height: 12px; border-radius: 50%; background: #111827; border: 1px solid #374151;"></span>
            <span>Black</span>
          </button>
          <button type="button" data-drawer-color data-name="Pink" style="padding: 0.65rem 0.5rem; border-radius: 0.75rem; border: 1px solid #E5E5E5; background: #FFFFFF; color: #111111; font-size: 0.75rem; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer;">
            <span style="width: 12px; height: 12px; border-radius: 50%; background: #F472B6; border: 1px solid #FBCFE8;"></span>
            <span>Pink</span>
          </button>
          <button type="button" data-drawer-color data-name="White" style="padding: 0.65rem 0.5rem; border-radius: 0.75rem; border: 1px solid #E5E5E5; background: #FFFFFF; color: #111111; font-size: 0.75rem; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer;">
            <span style="width: 12px; height: 12px; border-radius: 50%; background: #FFFFFF; border: 1px solid #D1D5DB;"></span>
            <span>White</span>
          </button>
          <button type="button" data-drawer-color data-name="Orange" style="padding: 0.65rem 0.5rem; border-radius: 0.75rem; border: 1px solid #E5E5E5; background: #FFFFFF; color: #111111; font-size: 0.75rem; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 6px; cursor: pointer;">
            <span style="width: 12px; height: 12px; border-radius: 50%; background: #F97316; border: 1px solid #FED7AA;"></span>
            <span>Orange</span>
          </button>
        </div>
      </div>

      <!-- Order Summary Card -->
      <div style="background: #FFFFFF; border: 1px solid #E5E5E5; border-radius: 1rem; padding: 1.25rem;">
        <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #555555; margin-bottom: 0.75rem;">
          Order Summary
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 13px; color: #555555; margin-bottom: 6px;">
          <span>Item:</span>
          <span id="drawer-summary-qty" style="color: #111111; font-weight: 600;">1x KOSNORA Case</span>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 13px; color: #555555; margin-bottom: 6px;">
          <span>Model:</span>
          <span id="drawer-summary-model" style="color: #111111; font-weight: 600;">iPhone 17 Pro Max</span>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 13px; color: #555555; margin-bottom: 6px;">
          <span>Color:</span>
          <span id="drawer-summary-color" style="color: #111111; font-weight: 600;">Gray</span>
        </div>
        <div style="display: none; justify-content: space-between; font-size: 13px; color: #059669; margin-bottom: 6px;">
          <span>Bundle Savings:</span>
          <span id="drawer-summary-savings" style="font-weight: 700;">-$0.00</span>
        </div>
        <div style="border-top: 1px solid #E5E5E5; padding-top: 8px; margin-top: 8px; display: flex; justify-content: space-between; font-size: 16px; font-weight: 800; color: #111111;">
          <span>Total:</span>
          <span id="drawer-summary-total">$79.90</span>
        </div>
      </div>
    </div>

    <!-- Real Shopify Cart Add Form with Dynamic Quantity and Return to Checkout -->
    <form action="{{ routes.cart_add_url | default: '/cart/add' }}" method="post" id="kosnora-drawer-cart-form" enctype="multipart/form-data" style="display: none;">
      <input type="hidden" name="id" id="drawer-variant-id" value="{{ real_variant.id }}">
      <input type="hidden" name="quantity" id="drawer-quantity-input" value="1">
      <input type="hidden" name="return_to" value="/checkout">
      <input type="hidden" name="properties[iPhone Model]" id="drawer-prop-model" value="iPhone 17 Pro Max">
      <input type="hidden" name="properties[Case Color]" id="drawer-prop-color" value="Gray">
      <input type="hidden" name="properties[Offer Selection]" id="drawer-prop-offer" value="1 Case">
    </form>

    <!-- Drawer Footer -->
    <div style="padding: 1.25rem 1.5rem; border-top: 1px solid #E5E5E5; background: #FFFFFF;">
      <!-- Variant Alert / Availability Message -->
      <div id="drawer-variant-alert" style="display: none; padding: 0.65rem 0.85rem; border-radius: 0.75rem; font-size: 12px; font-weight: 700; text-align: center; margin-bottom: 0.75rem; line-height: 1.4;"></div>

      <button type="button" id="drawer-proceed-checkout" class="kosnora-btn-primary" style="width: 100%; justify-content: center; cursor: pointer;">
        <span>PROCEED TO CHECKOUT (<span id="drawer-cta-total">$79.90</span>)</span>
        {% render 'icon-arrow-right' %}
      </button>
      <div style="font-size: 11px; color: #777777; text-align: center; margin-top: 8px;">
        Tax calculated at checkout · Free domestic shipping
      </div>
    </div>
  </div>
</div>
