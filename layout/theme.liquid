<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#FFFFFF">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
      <link rel="shortcut icon" href="{{ 'favicon.png' | asset_url }}" type="image/png">
      <link rel="apple-touch-icon" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet">

    <title>&#8203;</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- else -%}
      <meta name="description" content="Meet KOSNORA, a customizable smart phone case designed to change the image on the back of your phone whenever you want.">
    {%- endif -%}

    <!-- Social & OpenGraph Meta -->
    <meta property="og:site_name" content="{{ shop.name | default: 'KOSNORA' }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | default: 'KOSNORA — Smart NFC Phone Case' }}">
    <meta property="og:type" content="website">
    <meta property="og:description" content="{{ page_description | default: 'Meet KOSNORA, a customizable smart phone case designed to change the image on the back of your phone whenever you want.' }}">
    <meta name="twitter:card" content="summary_large_image">

    {{ content_for_header }}

    {%- assign target_product = nil -%}
    {%- if product != nil and product.id != blank -%}
      {%- assign target_product = product -%}
    {%- elsif settings.featured_product != blank and all_products[settings.featured_product] != blank -%}
      {%- assign target_product = all_products[settings.featured_product] -%}
    {%- elsif collections.all.products.size > 0 -%}
      {%- assign target_product = collections.all.products.first -%}
    {%- elsif collections.frontpage.products.size > 0 -%}
      {%- assign target_product = collections.frontpage.products.first -%}
    {%- else -%}
      {%- for col in collections -%}
        {%- if col.products.size > 0 and target_product == nil -%}
          {%- assign target_product = col.products.first -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if target_product == nil or target_product.id == blank -%}
      {%- assign target_product = all_products['case-kosnora-digital'] | default: all_products['ink-nfc-phone-case-for-iphone-17-16-15-14-pro-max-12-diy-picture-smart-screen-phone-cases-four-colors-image-screen-battery-free'] | default: all_products['kosnora-case'] | default: all_products['kosnora'] | default: all_products['kosnora-ink-nfc-smart-phone-case'] | default: all_products['kosnora-smart-phone-case'] -%}
    {%- endif -%}

    {%- assign real_variant = target_product.selected_or_first_available_variant | default: target_product.variants.first -%}

    <!-- Shopify Store & Checkout Routes Context -->
    <script>
      window.Shopify = window.Shopify || {};
      window.Shopify.routes = window.Shopify.routes || {
        root: {{ routes.root_url | default: '/' | json }}
      };

      window.KOSNORA_STORE = {
        root: {{ routes.root_url | default: '/' | json }},
        cartAddUrl: {{ routes.cart_add_url | default: '/cart/add.js' | json }},
        cartClearUrl: {{ routes.cart_clear_url | default: '/cart/clear.js' | json }},
        cartUrl: {{ routes.cart_url | default: '/cart' | json }},
        checkoutUrl: '/checkout',
        variantId: {{ real_variant.id | default: '' | json }},
        productId: {{ target_product.id | default: '' | json }},
        productHandle: {{ target_product.handle | default: '' | json }},
        productTitle: {{ target_product.title | default: 'KOSNORA Premium Phone Case' | json }},
        variants: {% if target_product != nil %}{{ target_product.variants | json }}{% else %}[]{% endif %},
        options: {% if target_product != nil %}{{ target_product.options | json }}{% else %}[]{% endif %}
      };

      window.KOSNORA_PRODUCT = {% if target_product != nil %}{{ target_product | json }}{% else %}null{% endif %};
      window.KOSNORA_COLLECTION_PRODUCTS = {{ collections.all.products | json | default: '[]' }};

      window.KOSNORA_CUSTOMER = {
        loggedIn: {% if customer %}true{% else %}false{% endif %},
        ordersCount: {{ customer.orders_count | default: 0 }},
        email: {{ customer.email | default: '' | json }},
        hasPreviousPurchase: {% if customer and customer.orders_count > 0 %}true{% else %}false{% endif %}
      };
    </script>

    <!-- KOSNORA Native Styles -->
    {{ 'kosnora.css' | asset_url | stylesheet_tag }}
    {{ 'kosnora-announcement-bar.css' | asset_url | stylesheet_tag }}
    {{ 'kosnora-multi-variant-bundle.css' | asset_url | stylesheet_tag }}
    {{ 'kosnora-reviews.css' | asset_url | stylesheet_tag }}

    <!-- KOSNORA Native Scripts -->
    <script src="{{ 'kosnora.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'kosnora-multi-variant-bundle.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'kosnora-reviews.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ template.name | default: 'index' }}">
    <a class="skip-to-content-link" href="#MainContent" style="position: absolute; top: -100px; left: 16px; z-index: 999; padding: 0.75rem 1.25rem; background: #111111; color: #FFFFFF; font-weight: 800; border-radius: 8px; text-decoration: none; transition: top 0.2s ease;" onfocus="this.style.top='16px'" onblur="this.style.top='-100px'">
      Skip to content
    </a>

    <!-- Infinite Benefits Announcement Bar Section (Top of site, above Header) -->
    {% section 'kosnora-announcement-bar' %}

    <!-- Header Section -->
    {% section 'header' %}

    <!-- Main Content for Online Store 2.0 -->
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Footer Section -->
    {% section 'footer' %}

    <!-- Reusable Cart/Order Drawer -->
    {% render 'order-drawer' %}

    <!-- Reusable Policy Dialog -->
    {% render 'policy-modal' %}
  </body>
</html>
